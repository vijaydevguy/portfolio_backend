# Server Configuration
PORT = 5000
NODE_ENV = development

# MongoDB Connection String (Add your MongoDB URI here)
MONGO_URI = mongodb+srv://<username>:<password>@cluster.mongodb.net/portfolio_db?retryWrites=true&w=majority

# Backend Self URL for Keep-Alive Cron Job (e.g. Render / Railway / Local)
BACKEND_URL = http://localhost:5000

# Client URL for CORS
CLIENT_URL = http://localhost:3000

# Authentication (JWT)
JWT_SECRET = your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN = 7d

# Cloudinary Configuration (Upload API Credentials)
CLOUDINARY_CLOUD_NAME = dtgn8hnabc
CLOUDINARY_API_KEY = your_cloudinary_api_key_here
CLOUDINARY_API_SECRET = your_cloudinary_api_secret_here

