# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Add your MongoDB URI here)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/portfolio_db?retryWrites=true&w=majority

# Backend Self URL for Keep-Alive Cron Job (e.g. Render / Railway / Local)
BACKEND_URL=http://localhost:5000

# Client URL for CORS
CLIENT_URL=http://localhost:3000
